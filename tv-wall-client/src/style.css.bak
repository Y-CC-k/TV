* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  background: #05060a;
  color: #e8ecf5;
  font-family: "Segoe UI", "Microsoft JhengHei", "Inter", system-ui, sans-serif;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
  user-select: none;
}

.app {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #05060a;
}

/* ── 標題列 ── */
.titlebar {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 38px;
  flex: none;
  padding: 0 0 0 12px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  background: rgba(255, 255, 255, 0.02);
  -webkit-app-region: drag;   /* 拖曳視窗 */
}

.dots {
  display: flex;
  align-self: stretch;
  align-items: center;
  gap: 6px;
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}
.dot:nth-child(1) { background: #22c55e; box-shadow: 0 0 6px rgba(34, 197, 94, 0.55); }
.dot:nth-child(2) { background: #3b82f6; box-shadow: 0 0 6px rgba(59, 130, 246, 0.55); }
.dot:nth-child(3) { background: #a855f7; box-shadow: 0 0 6px rgba(168, 85, 247, 0.55); }

.title {
  flex: 1;
  text-align: center;
  font-size: 14.5px;
  color: rgba(232, 236, 245, 0.75);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
  margin-right: 132px;   /* 抵銷右側控制按鈕寬度，讓標題置中 */
}

/* 視窗控制按鈕 */
.win-controls {
  display: flex;
  align-self: stretch;
  margin-left: 0;
  -webkit-app-region: no-drag;
}

.win-controls button {
  width: 44px;
  border: none;
  background: transparent;
  color: #cbd5e1;
  font-family: "Segoe MDL2 Assets", "Segoe Fluent Icons", sans-serif;
  font-size: 13px;
  cursor: pointer;
  outline: none;
}

.win-controls button:hover {
  background: rgba(255, 255, 255, 0.09);
  color: #fff;
}

.win-controls .win-close:hover {
  background: #e81123;
  color: #fff;
}

.title-face {
  font-family: "Segoe UI Black", "Microsoft JhengHei", "Segoe UI", sans-serif;
  font-weight: 900;
  letter-spacing: 0.18em;
  background: linear-gradient(178deg, #fff6dd 8%, #ffd36b 38%, #c89a38 62%, #fff2c8 88%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter:
    drop-shadow(0 0 6px rgba(255, 210, 120, 0.45))
    drop-shadow(0 0 14px rgba(0, 190, 255, 0.22));
}

.title-url {
  font-family: Consolas, monospace;
  font-size: 12px;
  color: rgba(0, 200, 255, 0.75);
  letter-spacing: 0.06em;
  text-shadow:
    0 0 8px rgba(0, 200, 255, 0.35),
    0 1px 0 rgba(0, 0, 0, 0.55);
}

/* ── 標籤列 ── */
.tabs {
  position: relative;
  display: flex;
  flex: none;
  gap: 6px;
  padding: 10px 12px 0;
  background: #05060a;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

/* 散景光斑背板 */
.tabs::before {
  content: "";
  position: absolute;
  inset: -30px;
  pointer-events: none;
  background:
    radial-gradient(circle 60px at 12% 120%, rgba(0, 190, 255, 0.38), transparent 70%),
    radial-gradient(circle 44px at 38% 140%, rgba(255, 215, 130, 0.22), transparent 70%),
    radial-gradient(circle 70px at 64% 130%, rgba(255, 0, 190, 0.28), transparent 70%),
    radial-gradient(circle 46px at 88% 145%, rgba(255, 170, 60, 0.2), transparent 70%),
    radial-gradient(circle 26px at 50% 150%, rgba(255, 255, 255, 0.12), transparent 70%);
  filter: blur(18px);
  animation: bokeh-drift 16s ease-in-out infinite alternate;
}

@keyframes bokeh-drift {
  from {
    transform: translate3d(-14px, 6px, 0) scale(1);
  }
  to {
    transform: translate3d(14px, -8px, 0) scale(1.08);
  }
}

/* ── 標籤本體 ── */
.tab {
  position: relative;
  appearance: none;
  border: none;
  background: transparent;
  color: rgba(232, 236, 245, 0.6);
  font-family: "Segoe UI Black", "Segoe UI", "Microsoft JhengHei", sans-serif;
  font-weight: 900;
  font-size: 17px;
  letter-spacing: 0.28em;
  cursor: pointer;
  border-radius: 16px 16px 0 0;
  transition: color 0.2s, text-shadow 0.2s;
  --t-line: transparent;
  --t-fill: rgba(52, 66, 96, 0.35);
  flex: 1;
  padding: 10px 4px;
  text-shadow:
    0 0 6px rgba(190, 220, 255, 0.25),
    0 1px 0 rgba(0, 0, 0, 0.55);
}

.tab::before,
.tab::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
}

/* 外框層：大圓角描邊 */
.tab::before {
  border: 1px solid var(--t-line);
  border-bottom: none;
  border-radius: 16px 16px 0 0;
  z-index: 0;
}

/* 填色層：小圓角、往內縮 1px 貼合外框 */
.tab::after {
  inset: 1px 1px 0 1px;
  border-radius: 9px 9px 0 0;
  background: var(--t-fill);
  z-index: 0;
}

/* 文字蓋在造型層之上 */
.tab-face {
  position: relative;
  z-index: 1;
}

.tab:hover {
  color: rgba(240, 246, 255, 0.95);
  text-shadow:
    0 0 10px rgba(190, 220, 255, 0.45),
    0 1px 0 rgba(0, 0, 0, 0.55);
}

/* 選中標籤：奢華金屬字面 + 邊緣輪廓光 */
.tab--active {
  --t-line: rgba(255, 222, 160, 0.28);
  --t-fill: linear-gradient(rgba(30, 40, 62, 0.72), rgba(12, 16, 28, 0.4));
  box-shadow: 0 -6px 18px rgba(255, 200, 120, 0.1);
  color: transparent;
  text-shadow: none;
}

.tab--active::after {
  box-shadow: inset 0 1px 0 rgba(255, 236, 200, 0.22);
}

.tab--active .tab-face {
  background: linear-gradient(178deg, #fff6dd 8%, #ffd36b 38%, #b98a2e 62%, #fff2c8 88%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  filter:
    drop-shadow(0 0 7px rgba(255, 210, 120, 0.5))
    drop-shadow(0 0 18px rgba(0, 190, 255, 0.28));
}

.tab--active:hover {
  color: transparent;
}

/* ── 內容區 ── */
.page {
  flex: 1;
  min-height: 0;
  display: flex;
  padding: 14px 16px 12px;
  background: #05060a;
  overflow-y: auto;
}

.page-body {
  position: relative;
  flex: 1;
  min-height: 0;
  padding: 2px;
  border-radius: 24px;
  background: linear-gradient(
    150deg,
    rgba(255, 210, 120, 0.55) 0%,
    rgba(120, 110, 80, 0.25) 22%,
    rgba(0, 190, 255, 0.45) 55%,
    rgba(255, 0, 190, 0.4) 85%,
    rgba(255, 210, 120, 0.45) 100%
  );
  box-shadow:
    0 10px 40px rgba(0, 0, 0, 0.55),
    0 0 30px rgba(0, 190, 255, 0.07),
    0 0 60px rgba(255, 190, 110, 0.05),
    inset 0 1px 0 rgba(255, 236, 200, 0.25);
}

.page-body::before {
  content: "";
  position: absolute;
  inset: 2px;
  border-radius: 17px;
  background:
    radial-gradient(ellipse 90% 60% at 50% -10%, rgba(20, 34, 60, 0.55), transparent 70%),
    linear-gradient(#0a101c 0%, #05060a 100%);
  box-shadow: inset 0 1px 0 rgba(255, 236, 200, 0.08);
}

.page-body > * {
  position: relative;
  z-index: 1;
}

.page-body.hidden {
  display: none;
}

/* 子區塊佈局 */
.panel-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* 積點查詢頁：左 1 : 右 4 佈局，頁面全寬 */
.panel-inner--query {
  max-width: none;
  width: 100%;
}

.query-cols {
  display: grid;
  grid-template-columns: 3fr 7fr;
  gap: 16px;
}

/* 左區：輸入框填滿 */
.query-cols #subHonorQuery input[type="text"] {
  flex: 1;
  min-width: 0;
}

/* 左區：下拉選單列（可換行排列） */
.query-rank-controls {
  flex-wrap: wrap;
}

.query-rank-controls select {
  width: auto;
  min-width: 105px;
  flex: 1 1 45%;
  padding: 7px 10px;
  font-size: 14px;
}

.query-rank-controls .btn-primary {
  flex: 1 1 100%;
  padding: 7px 14px;
  font-size: 14px;
}

/* 左區查詢結果表格：字體縮小以符合欄寬、不換行 */
.query-cols #subHonorQuery .result-table th,
.query-cols #subHonorQuery .result-table td {
  padding: 10px 6px;
  font-size: 18px;
}

/* 排行榜標題列：標題左、狀態訊息右 */
.rank-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.rank-title {
  white-space: nowrap;
}

.rank-header .msg {
  margin: 0;
  white-space: nowrap;
}

.sub-panel {
  background: #0a101c;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 16px;
  padding: 16px 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.sub-header {
  font-family: "Segoe UI Black", "Microsoft JhengHei", sans-serif;
  font-weight: 900;
  font-size: 16px;
  letter-spacing: 0.1em;
  color: #e8ecf5;
  margin-bottom: 12px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* ── 行 ── */
.row {
  margin: 10px 0;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.row.type-row {
  align-items: center;
}

label {
  font-size: 14px;
  width: 110px;
  color: #b9c4d6;
}

input[type="text"],
input[type="password"],
select {
  flex: 1;
  min-width: 150px;
  padding: 8px 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  font-size: 14px;
  background: rgba(20, 30, 48, 0.6);
  color: #e8ecf5;
}

input[type="text"]:focus,
input[type="password"]:focus,
select:focus {
  outline: none;
  border-color: #1a73e8;
}

/* ── 按鈕 ── */
.btn-primary {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  border: none;
  padding: 8px 18px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.2s;
  box-shadow: 0 2px 8px rgba(26, 115, 232, 0.3);
}

.btn-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, #3b82f6 0%, #1a73e8 100%);
  box-shadow: 0 4px 12px rgba(26, 115, 232, 0.45);
  transform: translateY(-1px);
}

.btn-primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  color: #b9c4d6;
  border: 1px solid rgba(255, 255, 255, 0.15);
  padding: 7px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 14px;
  transition: all 0.2s;
}

.btn-secondary:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.radio-inline {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-right: 14px;
  cursor: pointer;
  font-size: 14px;
  color: #b9c4d6;
}

.radio-inline input {
  margin: 0;
  accent-color: #1a73e8;
}

/* ── 狀態 ── */
.status {
  font-size: 13px;
  margin-left: 10px;
  padding: 2px 8px;
  border-radius: 12px;
  background: #1a1d2e;
  color: #e8ecf5;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.status.online {
  background: rgba(39, 101, 73, 0.25);
  color: #4ade80;
  border-color: rgba(74, 222, 128, 0.35);
}

.status.offline {
  background: rgba(197, 48, 48, 0.25);
  color: #f87171;
  border-color: rgba(248, 113, 113, 0.35);
}

/* ── 檔案資訊 ── */
.file-info {
  font-size: 13px;
  color: #94a3b8;
  margin-left: 10px;
}

/* ── 進度條 ── */
.progress-row {
  align-items: center;
  gap: 10px;
}

progress {
  flex: 1;
  height: 8px;
  border-radius: 4px;
  overflow: hidden;
  border: none;
  background: rgba(255, 255, 255, 0.08);
  color: #1a73e8;
}

progress::-webkit-progress-bar {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4px;
}

progress::-webkit-progress-value {
  background: #1a73e8;
  border-radius: 4px;
}

/* ── 訊息 ── */
.msg {
  font-size: 13px;
  margin-top: 6px;
  min-height: 18px;
}

.msg.success {
  color: #4ade80;
}

.msg.error {
  color: #f87171;
}

/* ── 拉條（slider）樣式 ── */
.slider-row {
  align-items: center;
  gap: 10px;
}

.slider-row input[type="range"] {
  flex: 1;
  height: 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.12);
  outline: none;
  -webkit-appearance: none;
}

.slider-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #1a73e8;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

.slider-row input[type="range"]::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #1a73e8;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

.slider-row span {
  font-weight: 600;
  color: #1a73e8;
  min-width: 30px;
  text-align: center;
}

/* ── 學生加分四區 ── */
.add-points-zones {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin: 12px 0;
}

.add-points-zone {
  background: rgba(20, 30, 48, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 14px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.add-points-zone:hover {
  border-color: #1a73e8;
  box-shadow: 0 4px 12px rgba(26, 115, 232, 0.2);
}

.add-points-zone .zone-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 10px;
}

.add-points-zone .zone-title {
  font-weight: 700;
  color: #b9c4d6;
  font-size: 14px;
}

.add-points-zone .zone-value {
  font-family: "Arial Black", Arial, sans-serif;
  font-weight: 900;
  color: #1a73e8;
  font-size: 16px;
}

.add-points-zone input[type="range"] {
  width: 100%;
  height: 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.12);
  outline: none;
  -webkit-appearance: none;
}

.add-points-zone input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #1a73e8;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

.add-points-zone input[type="range"]::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #1a73e8;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
}

/* ── 公告機列表 ── */
.server-list {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  background: rgba(10, 16, 28, 0.6);
  max-height: 300px;
  overflow-y: auto;
}

.server-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 14px;
}

.server-item:last-child {
  border-bottom: none;
}

.server-item:hover {
  background: rgba(255, 255, 255, 0.04);
}

.server-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.server-name {
  font-weight: 700;
  color: #e8ecf5;
}

.server-addr {
  font-size: 13px;
  color: #94a3b8;
}

.server-status {
  font-size: 12px;
  padding: 2px 8px;
  border-radius: 10px;
  background: rgba(20, 30, 48, 0.6);
  color: #b9c4d6;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.server-actions {
  display: flex;
  gap: 6px;
}

.server-actions button {
  padding: 4px 10px;
  font-size: 12px;
  border-radius: 4px;
  border: none;
  cursor: pointer;
}

.btn-edit {
  background: rgba(26, 115, 232, 0.15);
  color: #60a5fa;
}

.btn-edit:hover {
  background: rgba(26, 115, 232, 0.3);
}

.btn-delete {
  background: rgba(197, 48, 48, 0.15);
  color: #f87171;
}

.btn-delete:hover {
  background: rgba(197, 48, 48, 0.3);
}

.btn-connect {
  background: rgba(39, 101, 73, 0.15);
  color: #4ade80;
}

.btn-connect:hover {
  background: rgba(39, 101, 73, 0.3);
}

/* ── 檔案清單 ── */
.file-list {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  max-height: 300px;
  overflow-y: auto;
  background: rgba(10, 16, 28, 0.6);
}

.file-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  font-size: 14px;
}

.file-item:last-child {
  border-bottom: none;
}

.file-item:hover {
  background: rgba(255, 255, 255, 0.04);
}

.file-name {
  color: #e8ecf5;
  font-weight: 600;
}

.file-size {
  color: #94a3b8;
  font-size: 13px;
  margin-left: 10px;
}

.file-actions button {
  background: rgba(197, 48, 48, 0.15);
  color: #f87171;
  border: none;
  padding: 4px 10px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
}

.file-actions button:hover {
  background: rgba(197, 48, 48, 0.3);
}

.count {
  font-size: 13px;
  color: #94a3b8;
  margin-left: auto;
}

/* ── 好書介紹清單（表列） ── */
.book-table-wrap {
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  max-height: 360px;
  overflow-y: auto;
  background: rgba(10, 16, 28, 0.6);
}

.book-table {
  width: 100%;
  border-collapse: collapse;
  background: #0a101c;
}

.book-table th,
.book-table td {
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 8px 10px;
  text-align: center;
  font-size: 14px;
  color: #e8ecf5;
}

.book-table th {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  font-weight: 700;
  position: sticky;
  top: 0;
  z-index: 2;
}

.book-table .col-thumb { width: 90px; }
.book-table .col-title { width: 24%; }
.book-table .col-file { width: 38%; }
.book-table .col-size { width: 14%; }
.book-table .col-action { width: 10%; }

.book-table .col-title {
  text-align: left;
  font-weight: 600;
}

.book-table .col-file {
  text-align: left;
  color: #94a3b8;
  font-size: 13px;
  word-break: break-all;
}

.book-thumb {
  width: 72px;
  height: 48px;
  object-fit: cover;
  border-radius: 4px;
  background: #000;
  display: block;
  margin: 0 auto;
}

.book-actions button {
  background: rgba(197, 48, 48, 0.15);
  color: #f87171;
  border: none;
  padding: 4px 10px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12px;
}

.book-actions button:hover {
  background: rgba(197, 48, 48, 0.3);
}

/* ── 提示框 ── */
.hint {
  background: rgba(16, 50, 100, 0.25);
  border: 1px solid rgba(26, 115, 232, 0.35);
  border-radius: 6px;
  padding: 10px 14px;
  font-size: 13px;
  color: #93c5fd;
  margin-top: 12px;
}

/* ── 查詢結果表格 ── */
.student-info {
  background: rgba(10, 16, 28, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  padding: 16px;
  margin-top: 10px;
}

.result-table {
  width: 100%;
  border-collapse: collapse;
  background: #0a101c;
  margin-top: 10px;
  table-layout: fixed;
}

.result-table th,
.result-table td {
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 14px 10px;
  text-align: center;
  font-size: 24px;
  width: 20%;
}

.result-table th {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  font-weight: 700;
}

.result-table td {
  color: #e8ecf5;
}

.result-table td:first-child {
  font-weight: 700;
  color: #60a5fa;
}

.result-table tr:hover {
  background: rgba(255, 255, 255, 0.03);
}

/* ── 排行榜 ── */
.rank-table {
  width: 100%;
  border-collapse: collapse;
  background: #0a101c;
  table-layout: fixed;
}

.rank-table th,
.rank-table td {
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 10px 8px;
  text-align: center;
  font-size: 16px;
}

.rank-table th {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  color: #fff;
  font-weight: 700;
}

.rank-table .col-rank { width: 12%; }
.rank-table .col-card { width: 18%; }
.rank-table .col-name { width: 28%; }
.rank-table .col-class { width: 22%; }
.rank-table .col-points { width: 20%; }

.rank-table td {
  color: #e8ecf5;
}

.rank-table tr:hover {
  background: rgba(255, 255, 255, 0.03);
}

.rank-table tr:first-child td {
  color: #ffd700;
  font-weight: 700;
}

.rank-table tr:nth-child(2) td {
  color: #c0c0c0;
  font-weight: 700;
}

.rank-table tr:nth-child(3) td {
  color: #cd7f32;
  font-weight: 700;
}

.rank-table .pts {
  color: #60a5fa;
  font-weight: 700;
}

.rank-table tr:first-child .pts {
  color: #ffd700;
}

.rank-table tr:nth-child(2) .pts {
  color: #c0c0c0;
}

.rank-table tr:nth-child(3) .pts {
  color: #cd7f32;
}

.mode-btn {
  background: rgba(255, 255, 255, 0.06);
  color: #b9c4d6;
  border: 1px solid rgba(255, 255, 255, 0.14);
  padding: 8px 20px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  transition: all 0.2s;
}

.mode-btn:hover {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.mode-btn.active {
  background: linear-gradient(135deg, #1a73e8 0%, #0d47a1 100%);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 2px 8px rgba(26, 115, 232, 0.35);
}

/* ── Footer ── */
footer {
  flex: none;
  text-align: center;
  font-size: 11px;
  color: rgba(232, 236, 245, 0.4);
  margin-top: auto;
  padding: 8px 0;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

/* ── 班級勾選加分 ── */
.class-pick-row select {
  max-width: 240px;
  flex: 1;
}

.class-student-list {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
  width: 100%;
  padding: 10px;
  background: rgba(10, 16, 28, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
}

.class-student-list:empty::after {
  content: "請上方選擇年級班級載入學生";
  grid-column: 1 / -1;
  text-align: center;
  color: #94a3b8;
  font-size: 13px;
  padding: 24px 0;
}

.stu-check {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 8px 10px;
  cursor: pointer;
  font-size: 14px;
  color: #e8ecf5;
  transition: all 0.15s;
  user-select: none;
}

.stu-check:hover {
  background: rgba(255, 255, 255, 0.09);
  border-color: rgba(255, 255, 255, 0.25);
}

.stu-check input {
  margin: 0;
  accent-color: #1a73e8;
  width: 16px;
  height: 16px;
  flex: none;
}

.stu-check.checked {
  background: rgba(26, 115, 232, 0.2);
  border-color: #1a73e8;
  color: #fff;
}

.stu-check .stu-card {
  margin-left: auto;
  font-size: 12px;
  color: #94a3b8;
}

.stu-check.checked .stu-card {
  color: #93c5fd;
}
